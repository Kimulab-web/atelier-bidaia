---
import type { CollectionEntry } from 'astro:content';

interface Props {
  atelier: CollectionEntry<'ateliers'>;
}

const { atelier } = Astro.props;
const { titre, description, duree, niveau, prix, places } = atelier.data;
---

<article class="card">
  <div class="card__body">
    <h3 class="card__title">{titre}</h3>
    <p class="card__meta">{duree} · {niveau} · {places} places max</p>
    <p>{description}</p>
    <p class="card__price">{prix} €</p>
    <a href={`/ateliers/${atelier.id}`} class="btn" style="margin-top: var(--space-sm);">
      Voir l'atelier
    </a>
  </div>
</article>
