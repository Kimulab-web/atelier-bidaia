---
import BaseLayout from '../layouts/BaseLayout.astro';

const offres = [
  {
    emoji: '✂️',
    titre: 'Ateliers de couture',
    texte: "Séances en petit groupe, tous niveaux, pour apprendre à coudre en s'amusant. Machines et matériel fournis.",
    lien: '/ateliers',
    cta: 'Voir les ateliers',
  },
  {
    emoji: '👗',
    titre: 'Cours particuliers',
    texte: "Un projet précis, un rythme sur mesure. Séances individuelles adaptées à votre niveau et à votre envie.",
    lien: '/contact',
    cta: 'Demander un devis',
  },
  {
    emoji: '🧵',
    titre: 'Retouches & réparations',
    texte: "Ourlets, reprises, ajustements, transformations. Redonnez vie à vos vêtements préférés.",
    lien: '/retouches',
    cta: 'Voir les tarifs',
  },
];

const arguments_ = [
  { emoji: '🎓', titre: 'Couturière diplômée', texte: "Formation professionnelle et années de pratique pour un travail soigné." },
  { emoji: '👥', titre: 'Petits groupes', texte: "Maximum 6 personnes par atelier pour un vrai accompagnement personnalisé." },
  { emoji: '🧰', titre: 'Matériel fourni', texte: "Machines à coudre, tissus, mercerie : venez les mains dans les poches." },
  { emoji: '☕', titre: 'Ambiance conviviale', texte: "On coud, on apprend, on discute, on prend un thé. Chez soi, mais mieux." },
];

// Avis Google authentiques
const temoignages = [
  {
    auteur: 'Céline',
    date: 'il y a 2 mois',
    note: 5,
    texte: "J'ai acheté une robe cut-out qui me plaisait énormément mais je l'avais trop large au niveau du buste, de la taille et aussi trop longue. Sandra avec ses petits […]",
  },
  {
    auteur: 'Celine',
    date: 'il y a 1 mois',
    note: 5,
    texte: "Merci à Sandra pour son intervention sur ma robe. Elle est patiente, elle est force de proposition et a des doigts de fée. Je la recommande les yeux fermés !",
  },
  {
    auteur: 'Martine P.',
    date: 'il y a 4 mois',
    note: 5,
    texte: "Depuis septembre dernier je suis inscrite à des ateliers de couture hebdomadaires dont l'animatrice est Sandra ; j'étais tout à fait novice, et Sandra m'a […]",
  },
];

const faq = [
  {
    q: "Je n'ai jamais cousu, puis-je participer à un atelier ?",
    r: "Bien sûr ! Les ateliers d'initiation sont spécialement conçus pour les débutant·es. Aucune expérience n'est requise, tout le matériel est fourni et l'ambiance est bienveillante.",
  },
  {
    q: "Faut-il apporter sa propre machine à coudre ?",
    r: "Non, les machines sont à disposition dans l'atelier. Si vous préférez travailler sur la vôtre pour vous familiariser, vous pouvez tout à fait l'apporter.",
  },
  {
    q: "Combien de temps dure un atelier ?",
    r: "La durée varie selon le type d'atelier — généralement entre 2 et 4 heures. La durée exacte est indiquée sur la page de chaque atelier.",
  },
  {
    q: "Comment se déroule une retouche ?",
    r: "Vous passez à l'atelier avec votre vêtement, nous en discutons ensemble, je vous fais un devis clair et un délai. La plupart des retouches simples sont prêtes sous 3 à 7 jours.",
  },
  {
    q: "Proposez-vous des chèques cadeaux ?",
    r: "Oui, les ateliers et les créations peuvent être offerts. Contactez-moi pour un chèque cadeau personnalisé — parfait pour un anniversaire, la fête des mères ou Noël.",
  },
  {
    q: "Où se situe l'atelier ?",
    r: "L'atelier se trouve à Hasparren, au cœur du Pays Basque. L'adresse précise est communiquée lors de la réservation. Parking facile à proximité.",
  },
];
---

<BaseLayout
  title="Accueil"
  description="Atelier Bidaia Alaia à Hasparren — Ateliers de couture, cours particuliers et services de retouches au Pays Basque. Couturière diplômée."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container container--narrow" style="text-align: center;">
      <img src="/logo.png" alt="Atelier Bidaia Alaia" class="hero__logo" width="200" height="180" />
      <p class="hero__eyebrow">Couturière diplômée · Hasparren, Pays Basque</p>
      <h1>Ateliers de couture &amp; services de réparation au Pays Basque, à Hasparren</h1>
      <p class="hero__lede">
        Apprenez à coudre, faites retoucher vos vêtements ou offrez-vous une pièce unique —
        dans un atelier chaleureux, en plein cœur du Pays Basque.
      </p>
      <div class="hero__cta">
        <a href="/ateliers" class="btn">Découvrir les ateliers</a>
        <a href="/retouches" class="btn btn--ghost">Services de retouches</a>
      </div>
    </div>
  </section>

  <!-- OFFRES -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Nos offres</p>
        <h2>Ce que propose l'atelier Bidaia Alaia</h2>
      </header>
      <div class="grid grid--3">
        {offres.map((o) => (
          <article class="offre">
            <div class="offre__icon" aria-hidden="true">{o.emoji}</div>
            <h3>{o.titre}</h3>
            <p>{o.texte}</p>
            <a href={o.lien} class="offre__link">{o.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI NOUS CHOISIR -->
  <section class="section section--soft">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Pourquoi l'atelier</p>
        <h2>Pourquoi l'atelier Bidaia Alaia</h2>
      </header>
      <div class="grid grid--4">
        {arguments_.map((a) => (
          <div class="argument">
            <span class="argument__emoji" aria-hidden="true">{a.emoji}</span>
            <h3>{a.titre}</h3>
            <p>{a.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- L'ATELIER EN IMAGES -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">L'espace</p>
        <h2>L'atelier en images</h2>
        <p class="section-lede">Un espace lumineux, équipé et pensé pour la créativité — à Hasparren.</p>
      </header>
      <div class="galerie">
        <img src="/images/atelier-vue.jpg" alt="Vue générale de l'atelier avec table de coupe et machines" loading="lazy" />
        <img src="/images/atelier-machines.jpg" alt="Machines à coudre professionnelles dans l'atelier" loading="lazy" />
        <img src="/images/atelier-cabine.jpg" alt="Espace surjeteuses et cabine d'essayage" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGES -->
  <section class="section section--soft">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Ils en parlent</p>
        <h2>Ce que disent les client·es</h2>
        <p class="section-lede">Avis authentiques laissés sur Google.</p>
      </header>
      <div class="grid grid--3">
        {temoignages.map((t) => (
          <blockquote class="temoignage">
            <div class="temoignage__stars" aria-label={`${t.note} étoiles sur 5`}>
              {'★'.repeat(t.note)}<span class="temoignage__stars--empty">{'★'.repeat(5 - t.note)}</span>
            </div>
            <p class="temoignage__texte">« {t.texte} »</p>
            <footer class="temoignage__auteur">
              <strong>{t.auteur}</strong>
              <span class="temoignage__date">{t.date} · Google</span>
            </footer>
          </blockquote>
        ))}
      </div>
      <div style="text-align: center; margin-top: var(--space-lg);">
        <a href="https://www.google.com/search?q=atelier+bidaia+alaia+hasparren" target="_blank" rel="noopener" class="btn btn--ghost">
          Voir tous les avis Google
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <header class="section-head">
        <p class="eyebrow">Questions fréquentes</p>
        <h2>Vous vous demandez peut-être…</h2>
      </header>
      <div class="faq">
        {faq.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">{item.q}</summary>
            <div class="faq__reponse"><p>{item.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-final">
    <div class="container container--narrow" style="text-align: center;">
      <h2>Une question, un projet, une envie ?</h2>
      <p class="hero__lede">
        Contactez l'atelier — je vous réponds sous 48h et on trouve la solution qui vous convient.
      </p>
      <a href="/contact" class="btn">Prendre contact</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: var(--space-xl) 0 var(--space-2xl); background: linear-gradient(180deg, var(--color-primary-soft) 0%, var(--color-bg) 100%); }
  .hero__logo { max-width: 200px; height: auto; margin: 0 auto var(--space-sm); }
  .hero__eyebrow { font-family: var(--font-display); font-size: 0.9rem; color: var(--color-accent-hover); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-sm); }
  .hero__lede { font-size: 1.2rem; color: var(--color-text-muted); margin: var(--space-md) auto var(--space-lg); max-width: 620px; }
  .hero__cta { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; }

  .section-head { text-align: center; margin-bottom: var(--space-lg); }
  .eyebrow { font-family: var(--font-display); font-size: 0.85rem; color: var(--color-secondary-dark); font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: var(--space-xs); }
  .section-lede { color: var(--color-text-muted); max-width: 520px; margin: var(--space-sm) auto 0; }
  .section--soft { background: var(--color-primary-soft); }

  .grid--3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .grid--4 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }

  /* OFFRES */
  .offre { background: var(--color-surface); padding: var(--space-lg) var(--space-md); border-radius: var(--radius-lg); text-align: center; border: 1px solid var(--color-border); transition: transform 0.2s ease, box-shadow 0.2s ease; display: flex; flex-direction: column; gap: 0.5rem; }
  .offre:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .offre__icon { font-size: 2.5rem; margin-bottom: var(--space-xs); line-height: 1; }
  .offre h3 { font-size: 1.15rem; margin-bottom: var(--space-xs); }
  .offre p { color: var(--color-text-muted); font-size: 0.95rem; flex: 1; margin-bottom: var(--space-sm); }
  .offre__link { font-weight: 700; color: var(--color-accent-hover); font-family: var(--font-display); font-size: 0.95rem; }

  /* ARGUMENTS */
  .argument { text-align: center; padding: var(--space-md); }
  .argument__emoji { font-size: 2.5rem; display: block; margin-bottom: var(--space-sm); }
  .argument h3 { font-size: 1.15rem; margin-bottom: var(--space-xs); }
  .argument p { color: var(--color-text-muted); font-size: 0.95rem; }

  /* GALERIE */
  .galerie {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }
  .galerie img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .galerie img:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-md);
  }

  /* TÉMOIGNAGES */
  .temoignage { background: var(--color-surface); padding: var(--space-md); border-radius: var(--radius-lg); margin: 0; border: 1px solid var(--color-border); display: flex; flex-direction: column; }
  .temoignage__stars { color: var(--color-accent); font-size: 1.1rem; margin-bottom: var(--space-sm); letter-spacing: 0.1em; }
  .temoignage__stars--empty { color: var(--color-border); }
  .temoignage__texte { color: var(--color-text); font-style: italic; flex: 1; margin-bottom: var(--space-sm); font-size: 0.95rem; }
  .temoignage__auteur { color: var(--color-text-muted); font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .temoignage__auteur strong { color: var(--color-primary); font-weight: 700; font-family: var(--font-display); }
  .temoignage__date { font-size: 0.8rem; }

  /* FAQ */
  .faq { display: flex; flex-direction: column; gap: var(--space-xs); }
  .faq__item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0; overflow: hidden; }
  .faq__question { padding: var(--space-md); cursor: pointer; font-family: var(--font-display); font-weight: 600; color: var(--color-primary); list-style: none; position: relative; padding-right: 3rem; }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::after { content: '+'; position: absolute; right: var(--space-md); top: 50%; transform: translateY(-50%); font-size: 1.5rem; color: var(--color-accent-hover); font-weight: 400; line-height: 1; transition: transform 0.2s ease; }
  .faq__item[open] .faq__question::after { transform: translateY(-50%) rotate(45deg); }
  .faq__reponse { padding: 0 var(--space-md) var(--space-md); color: var(--color-text-muted); }
  .faq__reponse p { margin: 0; }

  /* CTA final */
  .cta-final { background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%); color: #fff; }
  .cta-final h2, .cta-final .hero__lede { color: #fff; }
  .cta-final .hero__lede { color: rgba(255,255,255,0.9); }
</style>
