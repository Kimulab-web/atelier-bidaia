---
import BaseLayout from '../layouts/BaseLayout.astro';

const galerie = [
  {
    titre: "Réparation d'un chino déchiré",
    description: "Reprise discrète et solide sur une déchirure au niveau de la poche arrière.",
    image: "/images/retouche-chino.jpg",
    seul: true,
  },
  {
    titre: "Rehaussement de taille sur pantalon",
    description: "Modification de la taille et ajout de boutons décoratifs sur un pantalon en satin rouge.",
    avant: "/images/retouche-pantalon-rouge-avant.jpg",
    apres: "/images/retouche-pantalon-rouge-apres.jpg",
  },
  {
    titre: "Restauration d'une broderie ancienne",
    description: "Reprise minutieuse d'une pièce brodée abîmée — le motif est reconstitué à l'identique.",
    avant: "/images/retouche-broderie-avant.jpg",
    apres: "/images/retouche-broderie-apres.jpg",
  },
];

const categories = [
  {
    titre: "Pantalons, bermudas, shorts",
    tarifs: [
      { prestation: "Ourlet piqué", prix: "13 €" },
      { prestation: "Ourlet invisible à la main", prix: "22 €" },
      { prestation: "Reprise ceinture", prix: "22 €" },
    ],
  },
  {
    titre: "Hauts, robes, chemises, blouses, t-shirts",
    tarifs: [
      { prestation: "Reprise côté", prix: "24 €" },
      { prestation: "Reprise longueur de manche", prix: "15 €" },
    ],
  },
  {
    titre: "Jupes et bas de robe",
    tarifs: [
      { prestation: "Ourlet recouvert", prix: "18 €" },
      { prestation: "Ourlet mouchoir", prix: "24 €" },
    ],
  },
  {
    titre: "Autres prestations",
    tarifs: [
      { prestation: "Pose de bouton", prix: "5 € / bouton" },
      { prestation: "Création de pinces", prix: "10 € / pince" },
      { prestation: "Création et pose de passants de ceinture", prix: "10 € / passant" },
    ],
  },
  {
    titre: "Réparations",
    note: "Tarifs modulés selon la taille de la pièce, son montage et sa matière.",
    tarifs: [
      { prestation: "Remplacement fermeture de braguette", prix: "22 €" },
      { prestation: "Reprise de couture décousue (moins de 5 cm)", prix: "8 €" },
      { prestation: "Réparation d'un accroc ou d'une déchirure", prix: "20 €" },
    ],
  },
];

const etapes = [
  { num: "1", titre: "Vous passez à l'atelier", texte: "Sans rendez-vous aux horaires d'ouverture, ou sur rendez-vous par téléphone." },
  { num: "2", titre: "On regarde ensemble", texte: "Je vous conseille la meilleure solution et vous propose un devis clair, sans surprise." },
  { num: "3", titre: "Je réalise la retouche", texte: "La plupart des retouches simples sont prêtes en 3 à 7 jours ouvrés." },
  { num: "4", titre: "Vous récupérez votre vêtement", texte: "Prêt à porter, comme neuf. Paiement à la remise." },
];
---

<BaseLayout
  title="Retouches couture au Pays Basque"
  description="Retouches, réparations et transformations de vêtements au Pays Basque, à Hasparren. Ourlets, reprises, ajustements — couturière diplômée, tarifs justes."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow" style="text-align: center;">Services</p>
      <h1 style="text-align: center;">Retouches &amp; réparations</h1>
      <p class="lede" style="text-align: center;">
        Ourlets, reprises, ajustements, transformations : redonnez vie à vos vêtements
        préférés plutôt que de les remplacer. Travail soigné, tarifs justes, délais rapides.
      </p>
    </div>
  </section>

  <!-- GALERIE AVANT/APRÈS -->
  <section class="section">
    <div class="container">
      <header class="galerie-head">
        <p class="eyebrow">Quelques exemples</p>
        <h2>Avant / après</h2>
        <p class="galerie-lede">Un aperçu du travail réalisé à l'atelier — de la simple réparation à la restauration délicate.</p>
      </header>
      <div class="galerie-grid">
        {galerie.map((g) => (
          <article class="galerie-item">
            <h3>{g.titre}</h3>
            {g.seul ? (
              <div class="galerie-image galerie-image--single">
                <img src={g.image} alt={g.titre} loading="lazy" />
              </div>
            ) : (
              <div class="galerie-image galerie-image--paire">
                <figure>
                  <img src={g.avant} alt={`${g.titre} — avant`} loading="lazy" />
                  <figcaption>Avant</figcaption>
                </figure>
                <figure>
                  <img src={g.apres} alt={`${g.titre} — après`} loading="lazy" />
                  <figcaption>Après</figcaption>
                </figure>
              </div>
            )}
            <p class="galerie-desc">{g.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container container--narrow">
      <h2 style="text-align: center; margin-bottom: var(--space-lg);">Comment ça se passe ?</h2>
      <ol class="etapes">
        {etapes.map((e) => (
          <li class="etape">
            <span class="etape__num">{e.num}</span>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2 style="text-align: center; margin-bottom: var(--space-sm);">Tarifs</h2>
      <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-lg);">
        Prix indicatifs. Un devis précis vous est remis après examen du vêtement.
      </p>

      {categories.map((cat) => (
        <div class="cat">
          <h3 class="cat__titre">{cat.titre}</h3>
          {cat.note && <p class="cat__note">{cat.note}</p>}
          <div class="tarifs">
            {cat.tarifs.map((t) => (
              <div class="tarif">
                <span class="tarif__prestation">{t.prestation}</span>
                <span class="tarif__prix">{t.prix}</span>
              </div>
            ))}
          </div>
        </div>
      ))}

      <p class="tarifs-footer">
        Un doute sur une réparation ? Passez à l'atelier ou envoyez-moi une photo par message —
        je vous dis tout de suite si c'est faisable et à quel prix.
      </p>
    </div>
  </section>

  <section class="section cta-final">
    <div class="container container--narrow" style="text-align: center;">
      <h2>Un vêtement à retoucher ?</h2>
      <p class="lede">Passez à l'atelier ou écrivez-moi pour un devis.</p>
      <a href="/contact" class="btn">Nous contacter</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin: var(--space-md) auto var(--space-lg);
    max-width: 620px;
  }
  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-secondary-dark);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-xs);
  }
  .section--soft { background: var(--color-primary-soft); }

  /* GALERIE AVANT/APRÈS */
  .galerie-head { text-align: center; margin-bottom: var(--space-lg); }
  .galerie-lede { color: var(--color-text-muted); max-width: 520px; margin: var(--space-sm) auto 0; }
  .galerie-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .galerie-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .galerie-item {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }
  .galerie-item h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-sm);
  }
  .galerie-image {
    margin-bottom: var(--space-sm);
  }
  .galerie-image--single img {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .galerie-image--paire {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .galerie-image--paire figure {
    margin: 0;
    text-align: center;
  }
  .galerie-image--paire img {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .galerie-image--paire figcaption {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .galerie-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .etapes {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .etape {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    background: var(--color-surface);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  .etape__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-accent);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .etape h3 { margin-bottom: 0.25rem; font-size: 1.1rem; }
  .etape p { margin: 0; color: var(--color-text-muted); }

  .cat { margin-bottom: var(--space-lg); }
  .cat__titre {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-secondary);
  }
  .cat__note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }

  .tarifs {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .tarif {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem var(--space-md);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-md);
  }
  .tarif:last-child { border-bottom: none; }
  .tarif__prestation { color: var(--color-text); }
  .tarif__prix {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent-hover);
    white-space: nowrap;
  }

  .tarifs-footer {
    text-align: center;
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: var(--space-md);
    background: var(--color-primary-soft);
    border-radius: var(--radius-lg);
  }

  .cta-final {
    background: var(--color-primary-soft);
    border-top: 3px solid var(--color-accent);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }
  .cta-final h2 { color: var(--color-primary); }
  .cta-final .lede { color: var(--color-text-muted); }
</style>
