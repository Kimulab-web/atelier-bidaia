---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const ateliers = await getCollection('ateliers', ({ data }) => data.publie);
  return ateliers.map((atelier) => ({
    params: { id: atelier.id },
    props: { atelier },
  }));
}

const { atelier } = Astro.props;
const { Content } = await render(atelier);
const { titre, description, duree, niveau, prix, surDevis, places, dates, horaire, stripeLink } = atelier.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
---

<BaseLayout title={`${titre} | Couture Pays Basque`} description={`${description} À Hasparren, Pays Basque, par une couturière diplômée.`}>
  <section class="section">
    <div class="container container--narrow">
      <a href="/ateliers" class="back-link">← Tous les ateliers</a>

      <header class="atelier-header">
        <h1>{titre}</h1>
        <p class="atelier-meta">{duree} · Niveau {niveau} · {places === 1 ? '1 personne (individuel)' : `${places} places max`}</p>
        {horaire && <p class="atelier-horaire">🗓️ {horaire}</p>}
      </header>

      <div class="atelier-body">
        <Content />
      </div>

      {dates && dates.length > 0 && (
        <div class="atelier-dates">
          <h2>Prochaines dates</h2>
          <ul>
            {dates.map((d) => <li>{formatDate(d)}</li>)}
          </ul>
        </div>
      )}

      <div class="atelier-booking">
        <p class="atelier-price">{surDevis ? 'Sur devis' : `${prix} €`}</p>
        {surDevis ? (
          <>
            <a href="/contact" class="btn">
              Demander un devis
            </a>
            <p class="booking-note">
              Contactez-moi pour discuter de votre projet et recevoir un devis personnalisé.
            </p>
          </>
        ) : stripeLink && !stripeLink.includes('REMPLACER') ? (
          <>
            <a href={stripeLink} class="btn" target="_blank" rel="noopener">
              Réserver l'atelier
            </a>
            <p class="booking-note">
              Paiement sécurisé via Stripe. Confirmation par e-mail immédiate.
            </p>
          </>
        ) : (
          <>
            <a href="/contact" class="btn">
              Réserver l'atelier
            </a>
            <p class="booking-note">
              Me contacter pour vérifier la disponibilité et réserver votre place.
            </p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .atelier-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }
  .atelier-meta {
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
  }
  .atelier-horaire {
    color: var(--color-primary);
    font-weight: 700;
    margin-top: var(--space-xs);
    font-family: var(--font-display);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }
  /* Espacements des sections dans le contenu markdown */
  .atelier-body :global(h2) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }
  .atelier-body :global(h2:first-child) {
    margin-top: 0;
  }
  .atelier-body :global(h3) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }
  .atelier-body :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  .atelier-body :global(ul li) {
    margin-bottom: 0.35rem;
  }
  .atelier-dates {
    background: var(--color-surface);
    padding: var(--space-md);
    border-radius: var(--radius);
    margin: var(--space-lg) 0;
  }
  .atelier-dates ul { padding-left: 1.25rem; }
  .atelier-booking {
    text-align: center;
    padding: var(--space-lg);
    background: var(--color-surface);
    border-radius: var(--radius);
    margin-top: var(--space-lg);
  }
  .atelier-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    color: var(--color-accent-hover);
    margin-bottom: var(--space-sm);
  }
  .booking-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
  }
</style>
