<BaseLayout title="Mentions légales">
  <section class="section">
    <div class="container container--narrow">
      <h1>Mentions légales</h1>

      <h2>Éditeur du site</h2>
      <p>
        Atelier Bidaia Alaia<br />
        [Statut juridique] — [SIRET]<br />
        [Adresse complète]<br />
        [Téléphone] — <a href="mailto:contact@atelier-bidaia.fr">contact@atelier-bidaia.fr</a>
      </p>
      <p>Directeur·rice de la publication : [Nom]</p>

      <h2>Hébergement</h2>
      <p>[Nom de l'hébergeur — Netlify / Vercel / OVH…]<br />[Adresse de l'hébergeur]</p>

      <h2>Développement</h2>
      <p>Site conçu et développé par <a href="https://kimulab.fr" target="_blank" rel="noopener">Kimulab</a>, agence digitale au Pays Basque.</p>

